# Local configuration for `node src/index.ts --env-file .env.loupe` (stdio mode).
# Copy to .env.loupe (gitignored) and adjust. Full reference: docs/configuration.md

LOUPE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://documents.example.com
LOUPE_DOCUMENT_INTELLIGENCE_KEY=<key>
LOUPE_OPENAI_ENDPOINT=https://openai.example.com
LOUPE_OPENAI_KEY=<key>
LOUPE_VISION_MODEL=gpt-5.6-luna

# `pnpm test:live` reads the same variables from .env.live (gitignored).
