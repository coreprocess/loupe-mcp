{
    "name": "loupe-mcp",
    "version": "0.0.0",
    "description": "MCP server that reads documents for AI agents: OCR of PDFs, scans, photos and Office files at two quality levels",
    "license": "MIT",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@10.34.9",
    "bin": {
        "loupe-mcp": "dist/index.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "biome check .",
        "format": "biome check --write .",
        "start": "node dist/index.js",
        "dev": "node src/index.ts",
        "test": "node --test --test-reporter=spec \"test/unit/**/*.test.ts\"",
        "test:integration": "node --test --test-reporter=spec --test-concurrency=1 \"test/integration/**/*.test.ts\"",
        "test:all": "pnpm test && pnpm test:integration",
        "test:live": "node --env-file-if-exists=.env.live --test --test-reporter=spec \"test/live/**/*.test.ts\""
    },
    "dependencies": {
        "@azure/identity": "4.14.0",
        "@azure/storage-blob": "12.34.0",
        "@modelcontextprotocol/express": "2.0.2",
        "@modelcontextprotocol/node": "2.1.2",
        "@modelcontextprotocol/server": "2.4.0",
        "@napi-rs/canvas": "1.0.13",
        "express": "5.3.0",
        "heic-decode": "2.1.0",
        "jose": "6.2.13",
        "markdown-it": "15.0.3",
        "pdfjs-dist": "6.4.299",
        "pino": "10.4.0",
        "sharp": "0.35.5",
        "undici": "7.30.1",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.3",
        "@modelcontextprotocol/client": "2.4.0",
        "@types/express": "5.0.6",
        "@types/markdown-it": "14.2.0",
        "@types/node": "^24.19.2",
        "fflate": "0.8.3",
        "testcontainers": "12.2.1",
        "typescript": "7.0.2"
    },
    "pnpm": {
        "ignoredBuiltDependencies": [
            "cpu-features",
            "protobufjs",
            "ssh2"
        ],
        "overrides": {
            "@azure/msal-node": "7.1.1"
        }
    }
}
